{
  "swagger": "2.0",
  "info": { "title": "Petstore v2 (fixture)", "version": "1.0.0" },
  "host": "petstore2.example",
  "basePath": "/api",
  "schemes": ["https"],
  "paths": {
    "/pets": {
      "get": {
        "operationId": "listPets",
        "summary": "List all pets",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "type": "integer"
          }
        ],
        "responses": { "200": { "description": "ok" } }
      },
      "post": {
        "operationId": "createPet",
        "summary": "Create a pet",
        "parameters": [
          {
            "name": "pet",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["name"],
              "properties": {
                "name": { "type": "string" },
                "tag": { "type": "string" }
              }
            }
          }
        ],
        "responses": { "201": { "description": "created" } }
      }
    },
    "/pets/{petId}": {
      "get": {
        "operationId": "getPetById",
        "summary": "Fetch one pet",
        "parameters": [
          {
            "name": "petId",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": { "200": { "description": "ok" } }
      }
    }
  }
}
